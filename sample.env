# 이 파일을 .env로 복사한 뒤 로컬 환경에 맞게 필요한 값만 수정합니다.
# 실제 인증 정보가 포함된 .env 파일은 커밋하거나 공유하지 않습니다.

# ============================================================
# 필수 입력값
# ============================================================

# Dashboard 인증 정보
HERMES_DASHBOARD_USERNAME=
HERMES_DASHBOARD_PASSWORD=
HERMES_DASHBOARD_SECRET=


# ============================================================
# 선택 옵션
# ============================================================

# Git commit identity / GitHub PR 게시
# dev-pr-publish에서 생성하는 commit author/committer에 사용합니다.
# GitHub 인증 토큰은 .env에 넣지 않습니다. update-devkit.ps1가 gh auth 상태를 확인하고
# 미인증이면 대화형 `gh auth login`을 실행하며, 인증 정보는 hermes-data volume에 저장합니다.
HERMES_GIT_USER_NAME=
HERMES_GIT_USER_EMAIL=
# Routed profile마다 HOME이 달라도 같은 global Git identity를 읽도록 persistent 경로를 사용합니다.
HERMES_GIT_CONFIG_GLOBAL=/opt/data/gitconfig
HERMES_GH_CONFIG_DIR=/opt/data/gh

# OpenAI 호환 API 서버
# 기본값은 비활성화이며, 사용할 때만 활성화하고 API Key를 설정합니다.
HERMES_API_SERVER_ENABLED=false
HERMES_API_SERVER_KEY=

# Jira Cloud 연동
# Jira 기능을 사용할 때만 인증 정보를 입력합니다.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

JIRA_API_VERSION=3
JIRA_ACCEPTANCE_CRITERIA_FIELDS=Acceptance Criteria,완료 조건,인수 조건
JIRA_INCLUDE_FIELD_NAMES=
JIRA_VERIFY_SSL=true

FIGMA_ACCESS_TOKEN=
FIGMA_OAUTH_TOKEN=
CONTEXT7_API_KEY=

HERMES_KANBAN_NOTIFY_ENABLED=false
HERMES_KANBAN_NOTIFY_PLATFORM=discord
HERMES_KANBAN_NOTIFY_TARGET=
HERMES_KANBAN_NOTIFY_DELIVERY_MODE=notify
HERMES_KANBAN_NOTIFY_CHAT_TYPE=channel
HERMES_KANBAN_NOTIFY_PROFILE=default
DISCORD_BOT_TOKEN=

# ============================================================
# 기본 설정된 값
# ============================================================
HERMES_FLOW_MODEL_DEFAULT_PROVIDER=openai-codex
HERMES_FLOW_MODEL_DEFAULT=gpt-5.6-terra
HERMES_FLOW_MODEL_PREMIUM_PROVIDER=openai-codex
HERMES_FLOW_MODEL_PREMIUM=gpt-6-astra

HERMES_COMPOSE_PROJECT_NAME=hermes-dev
HERMES_CONTAINER_NAME=hermes-dev
HERMES_IMAGE_NAME=hermes-dev
HERMES_IMAGE_TAG=0.1.0
HERMES_DATA_VOLUME_NAME=hermes-dev-data
HERMES_BASE_IMAGE=nousresearch/hermes-agent:v2026.8.16.2

HERMES_HOST_WORKSPACE_PATH=D:/workspace
HERMES_CONTAINER_WORKSPACE_PATH=/workspace
HERMES_HOST_CUSTOM_SKILLS_PATH=./custom-skills
HERMES_CONTAINER_CUSTOM_SKILLS_PATH=/opt/custom-skills
HERMES_GRADLE_PROJECT_CACHE_ROOT=/opt/data/gradle/project-cache
HERMES_GRADLE_COMPILE_PREFLIGHT_TIMEOUT_SECONDS=300
HERMES_HOST_SHARED_PATH=./shared
HERMES_CONTAINER_SHARED_PATH=/opt/data/shared
HERMES_WRITE_SAFE_ROOT=/workspace:/opt/data
HERMES_PORT_BIND_ADDRESS=127.0.0.1
HERMES_TIMEZONE=Asia/Seoul
HERMES_DASHBOARD_HOST=0.0.0.0
HERMES_DASHBOARD_HOST_PORT=9119
HERMES_DASHBOARD_CONTAINER_PORT=9119
HERMES_API_SERVER_HOST=0.0.0.0
HERMES_API_SERVER_HOST_PORT=8642
HERMES_API_SERVER_CONTAINER_PORT=8642
HERMES_WORK_ITEM_DIR=/opt/data/work-items
