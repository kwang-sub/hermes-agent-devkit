#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "Usage: hermes-java <command> [args...]" >&2
  exit 2
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$repo_root" ]; then
  echo "hermes-java: current directory is not inside a Git repository" >&2
  exit 2
fi

toolchain_file="$repo_root/.hermes/toolchain.env"
if [ ! -f "$toolchain_file" ]; then
  echo "hermes-java: missing $toolchain_file; run dev-project-bootstrap first" >&2
  exit 2
fi

# toolchain.env is generated by dev-project-bootstrap and contains only the
# selected Java version/home. Do not source arbitrary project environment files.
# shellcheck disable=SC1090
. "$toolchain_file"

if [ -z "${JAVA_HOME:-}" ] || [ ! -x "$JAVA_HOME/bin/java" ]; then
  echo "hermes-java: invalid JAVA_HOME from $toolchain_file: ${JAVA_HOME:-<unset>}" >&2
  exit 2
fi

export JAVA_HOME
export PATH="$JAVA_HOME/bin:$PATH"

resolve_cached_gradle() {
  local wrapper_properties="$1"
  local distribution_url
  local distribution_file
  local distribution_name
  local gradle_home_name
  local gradle_user_home
  local cache_base
  local candidate

  if [ ! -f "$wrapper_properties" ]; then
    echo "hermes-java: Gradle wrapper JAR is missing and wrapper properties were not found: $wrapper_properties" >&2
    return 2
  fi

  distribution_url="$(
    sed -n 's/^[[:space:]]*distributionUrl[[:space:]]*=[[:space:]]*//p' "$wrapper_properties" \
      | tail -n 1
  )"
  if [ -z "$distribution_url" ]; then
    echo "hermes-java: distributionUrl is missing from $wrapper_properties" >&2
    return 2
  fi

  distribution_file="${distribution_url##*/}"
  distribution_file="${distribution_file%%\?*}"
  distribution_name="${distribution_file%.zip}"

  case "$distribution_name" in
    gradle-*-bin)
      gradle_home_name="${distribution_name%-bin}"
      ;;
    gradle-*-all)
      gradle_home_name="${distribution_name%-all}"
      ;;
    *)
      echo "hermes-java: unsupported Gradle distributionUrl in $wrapper_properties: $distribution_url" >&2
      return 2
      ;;
  esac

  gradle_user_home="${GRADLE_USER_HOME:-${HOME:-/opt/data}/.gradle}"
  cache_base="$gradle_user_home/wrapper/dists/$distribution_name"

  for candidate in "$cache_base"/*/"$gradle_home_name/bin/gradle"; do
    if [ -x "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  echo "hermes-java: Gradle wrapper JAR is missing and cached distribution was not found: $cache_base" >&2
  echo "hermes-java: restore gradle/wrapper/gradle-wrapper.jar or warm the exact Gradle distribution cache first" >&2
  return 2
}

command_path="$1"
command_name="$(basename "$command_path")"

# Windows and Docker share /workspace through a bind mount. Gradle's default
# project-local .gradle directory stores absolute execution/output paths, so
# reusing it from both environments can leak /workspace paths into Windows
# builds. Keep only dispatcher-side Gradle project state under /opt/data while
# leaving the project's build/ outputs and GRADLE_USER_HOME unchanged.
if [ "$command_name" = "gradlew" ]; then
  has_project_cache_dir=false
  for arg in "$@"; do
    case "$arg" in
      --project-cache-dir|--project-cache-dir=*)
        has_project_cache_dir=true
        break
        ;;
    esac
  done

  gradle_extra_args=()
  if [ "$has_project_cache_dir" = false ]; then
    cache_root="${HERMES_GRADLE_PROJECT_CACHE_ROOT:-/opt/data/gradle-project-cache}"
    repo_name="$(printf '%s' "$(basename "$repo_root")" | tr -c '[:alnum:]._-' '_')"
    repo_hash="$(printf '%s' "$repo_root" | git hash-object --stdin | cut -c1-12)"
    project_cache_dir="$cache_root/${repo_name}-${repo_hash}"

    if ! mkdir -p "$project_cache_dir"; then
      echo "hermes-java: cannot create Gradle project cache: $project_cache_dir" >&2
      exit 2
    fi
    if [ ! -w "$project_cache_dir" ]; then
      echo "hermes-java: Gradle project cache is not writable: $project_cache_dir" >&2
      exit 2
    fi

    gradle_extra_args=(--project-cache-dir "$project_cache_dir")
  fi

  wrapper_root="$(cd "$(dirname "$command_path")" && pwd -P)"
  wrapper_jar="$wrapper_root/gradle/wrapper/gradle-wrapper.jar"
  wrapper_properties="$wrapper_root/gradle/wrapper/gradle-wrapper.properties"

  shift

  if [ -f "$wrapper_jar" ]; then
    exec "$command_path" "${gradle_extra_args[@]}" "$@"
  fi

  if ! cached_gradle="$(resolve_cached_gradle "$wrapper_properties")"; then
    exit 2
  fi

  echo "hermes-java: Gradle wrapper JAR missing; using cached distribution: $cached_gradle" >&2
  exec "$cached_gradle" "${gradle_extra_args[@]}" "$@"
fi

exec "$@"
