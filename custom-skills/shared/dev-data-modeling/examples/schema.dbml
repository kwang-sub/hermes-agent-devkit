Table account {
  id bigint [pk]
  name varchar(100) [not null]
}

Table transaction {
  id bigint [pk]
  account_id bigint [not null]
  amount decimal(19,4) [not null]
  occurred_at timestamp [not null]

  indexes {
    (account_id, occurred_at)
  }
}

TableGroup finance {
  account
  transaction
}

Ref: transaction.account_id > account.id
