#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "Usage: hermes-java <command> [args...]" >&2
  exit 2
fi

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$repo_root" ]; then
  echo "hermes-java: current directory is not inside a Git repository" >&2
  exit 2
fi

toolchain_file="$repo_root/.hermes/toolchain.env"
if [ ! -f "$toolchain_file" ]; then
  echo "hermes-java: missing $toolchain_file; run dev-project-bootstrap first" >&2
  exit 2
fi

# toolchain.env is generated by dev-project-bootstrap and contains only the
# selected Java version/home. Do not source arbitrary project environment files.
# shellcheck disable=SC1090
. "$toolchain_file"

if [ -z "${JAVA_HOME:-}" ] || [ ! -x "$JAVA_HOME/bin/java" ]; then
  echo "hermes-java: invalid JAVA_HOME from $toolchain_file: ${JAVA_HOME:-<unset>}" >&2
  exit 2
fi

export JAVA_HOME
export PATH="$JAVA_HOME/bin:$PATH"
exec "$@"
