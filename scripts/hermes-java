#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "Usage: hermes-java <command> [args...]" >&2
  exit 2
fi

workspace_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$workspace_root" ]; then
  echo "hermes-java: current directory is not inside a Git repository" >&2
  exit 2
fi

worktree_listing="$(git -C "$workspace_root" worktree list --porcelain 2>/dev/null || true)"
primary_root="$(printf '%s\n' "$worktree_listing" | sed -n 's/^worktree //p' | head -n 1)"
if [ -z "$primary_root" ] || [ ! -d "$primary_root" ]; then
  echo "hermes-java: cannot resolve primary worktree from $workspace_root" >&2
  exit 2
fi

toolchain_file="$primary_root/.hermes/toolchain.env"
if [ ! -f "$toolchain_file" ]; then
  echo "hermes-java: missing canonical $toolchain_file; run dev-project-bootstrap for the primary repository first" >&2
  exit 2
fi

# shellcheck disable=SC1090
. "$toolchain_file"

if [ -z "${JAVA_HOME:-}" ] || [ ! -x "$JAVA_HOME/bin/java" ]; then
  echo "hermes-java: invalid JAVA_HOME from $toolchain_file: ${JAVA_HOME:-<unset>}" >&2
  exit 2
fi

export JAVA_HOME
export PATH="$JAVA_HOME/bin:$PATH"

gradle_root="${HERMES_GRADLE_ROOT:-/opt/data/gradle}"
export GRADLE_USER_HOME="${HERMES_GRADLE_USER_HOME:-$gradle_root/user-home}"
gradle_distribution_root="${HERMES_GRADLE_DIST_ROOT:-$gradle_root/distributions}"
gradle_download_root="${HERMES_GRADLE_DOWNLOAD_ROOT:-$gradle_root/downloads}"
gradle_lock_root="${HERMES_GRADLE_LOCK_ROOT:-$gradle_root/locks}"
gradle_project_cache_root="${HERMES_GRADLE_PROJECT_CACHE_ROOT:-$gradle_root/project-cache}"
gradle_build_root="${HERMES_GRADLE_BUILD_ROOT:-$gradle_root/builds}"
gradle_init_root="${HERMES_GRADLE_INIT_ROOT:-$gradle_root/init}"
gradle_session_guard_root="${HERMES_GRADLE_SESSION_GUARD_ROOT:-$gradle_root/session-blocks}"

mkdir -p \
  "$GRADLE_USER_HOME" \
  "$gradle_distribution_root" \
  "$gradle_download_root" \
  "$gradle_lock_root" \
  "$gradle_project_cache_root" \
  "$gradle_build_root" \
  "$gradle_init_root" \
  "$gradle_session_guard_root"

sanitize_guard_value() {
  printf '%s' "$1" | sed 's/[^[:alnum:]_.-]/_/g'
}

check_gradle_session_guard() {
  if [ "${HERMES_GRADLE_BOUNDED_HELPER:-0}" = "1" ]; then
    return 0
  fi
  if [ -z "${HERMES_KANBAN_TASK:-}" ] || [ -z "${HERMES_SESSION_ID:-}" ]; then
    return 0
  fi
  local task session marker
  task="$(sanitize_guard_value "$HERMES_KANBAN_TASK")"
  session="$(sanitize_guard_value "$HERMES_SESSION_ID")"
  marker="$gradle_session_guard_root/${task}--${session}.blocked"
  if [ -f "$marker" ]; then
    echo "hermes-java: direct Gradle execution is blocked for this Kanban session after bounded verification returned BLOCKED" >&2
    echo "hermes-java: use the existing gradle_verification evidence and kanban_block; start a new worker/session to retry after the blocker is resolved" >&2
    exit 2
  fi
}

read_gradle_property() {
  local properties_file="$1"
  local property_name="$2"
  sed -n "s/^[[:space:]]*${property_name}[[:space:]]*=[[:space:]]*//p" "$properties_file" | tail -n 1 | tr -d '\r'
}

normalize_distribution_url() {
  printf '%s' "$1" | sed 's#\\:#:#g'
}

ensure_internal_build_init_script() {
  local init_script="$1"
  local temp_script="${init_script}.tmp.$$"
  cat > "$temp_script" <<'GRADLE'
gradle.beforeProject { project ->
    def hermesBuildRoot = System.getenv('HERMES_GRADLE_BUILD_DIR')
    if (hermesBuildRoot) {
        def projectKey = project.path == ':' ? 'root' : project.path.substring(1).replace(':', '/')
        project.buildDir = new File(hermesBuildRoot, projectKey)
    }
}
GRADLE
  mv "$temp_script" "$init_script"
}

resolve_managed_gradle() {
  local wrapper_properties="$1"
  local distribution_url_raw distribution_url distribution_sha
  local distribution_file distribution_name gradle_home_name
  local install_dir candidate archive lock_file temp_archive temp_dir actual_sha

  if [ ! -f "$wrapper_properties" ]; then
    echo "hermes-java: Gradle wrapper properties were not found: $wrapper_properties" >&2
    return 2
  fi

  distribution_url_raw="$(read_gradle_property "$wrapper_properties" "distributionUrl")"
  if [ -z "$distribution_url_raw" ]; then
    echo "hermes-java: distributionUrl is missing from $wrapper_properties" >&2
    return 2
  fi
  distribution_url="$(normalize_distribution_url "$distribution_url_raw")"
  distribution_sha="$(read_gradle_property "$wrapper_properties" "distributionSha256Sum")"

  distribution_file="${distribution_url##*/}"
  distribution_file="${distribution_file%%\?*}"
  distribution_name="${distribution_file%.zip}"

  case "$distribution_name" in
    gradle-*-bin) gradle_home_name="${distribution_name%-bin}" ;;
    gradle-*-all) gradle_home_name="${distribution_name%-all}" ;;
    *)
      echo "hermes-java: unsupported Gradle distributionUrl in $wrapper_properties: $distribution_url" >&2
      return 2
      ;;
  esac

  install_dir="$gradle_distribution_root/$distribution_name"
  candidate="$install_dir/$gradle_home_name/bin/gradle"
  if [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  lock_file="$gradle_lock_root/distribution-${distribution_name}.lock"
  exec 9>"$lock_file"
  if ! flock -w "${HERMES_GRADLE_LOCK_TIMEOUT_SECONDS:-300}" 9; then
    echo "hermes-java: timed out waiting for Gradle distribution lock: $lock_file" >&2
    return 2
  fi

  if [ -x "$candidate" ]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  archive="$gradle_download_root/$distribution_file"
  if [ ! -s "$archive" ]; then
    temp_archive="$archive.part.$$"
    rm -f "$temp_archive"
    echo "hermes-java: Gradle cache miss; downloading $distribution_url" >&2
    if ! curl -fL --retry 3 --connect-timeout 20 "$distribution_url" -o "$temp_archive"; then
      rm -f "$temp_archive"
      echo "hermes-java: failed to download Gradle distribution: $distribution_url" >&2
      return 2
    fi
    mv "$temp_archive" "$archive"
  fi

  if [ -n "$distribution_sha" ]; then
    actual_sha="$(sha256sum "$archive" | awk '{print $1}')"
    if [ "$actual_sha" != "$distribution_sha" ]; then
      rm -f "$archive"
      echo "hermes-java: Gradle distribution checksum mismatch: expected=$distribution_sha actual=$actual_sha" >&2
      return 2
    fi
  else
    echo "hermes-java: warning: distributionSha256Sum is not set; using downloaded archive without project checksum" >&2
  fi

  temp_dir="$gradle_distribution_root/.${distribution_name}.tmp.$$"
  rm -rf "$temp_dir"
  mkdir -p "$temp_dir"
  if ! unzip -q "$archive" -d "$temp_dir"; then
    rm -rf "$temp_dir"
    echo "hermes-java: failed to extract Gradle distribution: $archive" >&2
    return 2
  fi

  if [ ! -x "$temp_dir/$gradle_home_name/bin/gradle" ]; then
    rm -rf "$temp_dir"
    echo "hermes-java: extracted Gradle distribution is missing executable: $gradle_home_name/bin/gradle" >&2
    return 2
  fi

  rm -rf "$install_dir"
  mv "$temp_dir" "$install_dir"
  candidate="$install_dir/$gradle_home_name/bin/gradle"
  printf '%s\n' "$candidate"
}

command_path="$1"
command_name="$(basename "$command_path")"

if [ "$command_name" = "gradlew" ]; then
  check_gradle_session_guard

  has_project_cache_dir=false
  for arg in "$@"; do
    case "$arg" in
      --project-cache-dir|--project-cache-dir=*) has_project_cache_dir=true; break ;;
    esac
  done

  repo_name="$(printf '%s' "$(basename "$workspace_root")" | tr -c '[:alnum:]._-' '_')"
  repo_hash="$(printf '%s' "$workspace_root" | git hash-object --stdin | cut -c1-12)"
  workspace_key="${repo_name}-${repo_hash}"

  gradle_extra_args=()
  if [ "$has_project_cache_dir" = false ]; then
    project_cache_dir="$gradle_project_cache_root/$workspace_key"
    mkdir -p "$project_cache_dir"
    if [ ! -w "$project_cache_dir" ]; then
      echo "hermes-java: Gradle project cache is not writable: $project_cache_dir" >&2
      exit 2
    fi
    gradle_extra_args+=(--project-cache-dir "$project_cache_dir")
  fi

  build_dir="$gradle_build_root/$workspace_key"
  mkdir -p "$build_dir"
  if [ ! -w "$build_dir" ]; then
    echo "hermes-java: Gradle internal build directory is not writable: $build_dir" >&2
    exit 2
  fi
  export HERMES_GRADLE_BUILD_DIR="$build_dir"

  build_init_script="$gradle_init_root/hermes-build-output.gradle"
  ensure_internal_build_init_script "$build_init_script"
  gradle_extra_args+=(--init-script "$build_init_script")

  wrapper_root="$(cd "$(dirname "$command_path")" && pwd -P)"
  wrapper_properties="$wrapper_root/gradle/wrapper/gradle-wrapper.properties"
  shift

  if ! managed_gradle="$(resolve_managed_gradle "$wrapper_properties")"; then
    exit 2
  fi

  workspace_lock_file="$gradle_lock_root/workspace-${workspace_key}.lock"
  echo "hermes-java: using managed Gradle distribution: $managed_gradle" >&2
  echo "hermes-java: internal build output: $build_dir" >&2
  echo "hermes-java: workspace lock: $workspace_lock_file" >&2
  set +e
  flock -E 73 -w "${HERMES_GRADLE_WORKSPACE_LOCK_TIMEOUT_SECONDS:-600}" \
    "$workspace_lock_file" \
    "$managed_gradle" "${gradle_extra_args[@]}" "$@"
  status=$?
  set -e
  if [ "$status" -eq 73 ]; then
    echo "hermes-java: timed out waiting for Gradle workspace lock: $workspace_lock_file" >&2
    exit 2
  fi
  exit "$status"
fi

exec "$@"
