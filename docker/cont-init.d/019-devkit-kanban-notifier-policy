#!/command/with-contenv sh
# Keep optional notifications, but never initialize or edit legacy role profiles.
set -eu
if [ ! -f /run/devkit-ready ] || [ -L /run/devkit-ready ]; then
    echo "[devkit] Notifier setup refused before successful migration" >&2
    exit 1
fi
export HOME=/opt/data HERMES_HOME=/opt/data
HERMES_CLI=/opt/hermes/.venv/bin/hermes
HERMES_PYTHON=/opt/hermes/.venv/bin/python
run_as_hermes() { if [ "$(id -u)" = 0 ]; then s6-setuidgid hermes "$@"; else "$@"; fi; }
# Native dispatch is independently disabled by config and immutable container ENV.
run_as_hermes "$HERMES_CLI" config set kanban.notify_in_gateway false >/dev/null
run_as_hermes "$HERMES_CLI" config set kanban.auto_subscribe_on_create false >/dev/null
run_as_hermes "$HERMES_PYTHON" /opt/devkit/bin/devkit_kanban_notifier.py --initialize-state >/dev/null
NOTIFIER_SERVICE_DIR=/run/service/devkit-notifier
NOTIFIER_TMP_DIR=/run/service/.devkit-notifier.tmp
if [ ! -e "$NOTIFIER_SERVICE_DIR/run" ]; then
    mkdir -p "$NOTIFIER_TMP_DIR"
    cp /opt/devkit/svscan/devkit-notifier/run "$NOTIFIER_TMP_DIR/run"
    chmod 0755 "$NOTIFIER_TMP_DIR/run"
    mv "$NOTIFIER_TMP_DIR" "$NOTIFIER_SERVICE_DIR"
fi
/command/s6-svscanctl -a /run/service
attempt=0
while [ "$attempt" -lt 50 ]; do
    if /command/s6-svstat "$NOTIFIER_SERVICE_DIR" >/dev/null 2>&1; then
        echo '[devkit] Optional Kanban notifier service registered'
        exit 0
    fi
    attempt=$((attempt + 1)); sleep 0.1
done
echo '[devkit] Notifier registration failed' >&2
exit 1
